<?xml version="1.0" encoding="UTF-8"?>
<!-- Equivalent of WorldEdit's :worldedit-cli Gradle project, compiled from the unmodified sources. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>local.worldedit-build</groupId>
    <artifactId>upstream-parent</artifactId>
    <version>1</version>
  </parent>
  <groupId>com.sk89q.worldedit</groupId>
  <artifactId>worldedit-cli</artifactId>
  <version>7.3.8</version>

  <properties>
    <we.cli.dir>${src.root}/WorldEdit/worldedit-cli</we.cli.dir>
  </properties>

  <dependencies>
    <dependency><groupId>com.sk89q.worldedit</groupId><artifactId>worldedit-core</artifactId><version>${we.version}</version></dependency>
    <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId></dependency>
    <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId></dependency>
    <dependency><groupId>commons-cli</groupId><artifactId>commons-cli</artifactId></dependency>
    <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId></dependency>
    <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId></dependency>
    <dependency><groupId>com.sk89q.worldedit.worldedit-libs</groupId><artifactId>ap</artifactId><version>${we.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><scope>provided</scope></dependency>
  </dependencies>

  <build>
    <sourceDirectory>${we.cli.dir}/src/main/java</sourceDirectory>
    <resources>
      <resource><directory>${we.cli.dir}/src/main/resources</directory></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path><groupId>com.sk89q.worldedit.worldedit-libs</groupId><artifactId>ap</artifactId><version>${we.version}</version></path>
            <path><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>${guava.version}</version></path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Implementation-Version>${we.version}+${we.commit}</Implementation-Version>
              <WorldEdit-Version>${we.version}+${we.commit}</WorldEdit-Version>
              <Main-Class>com.sk89q.worldedit.cli.CLIWorldEdit</Main-Class>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
