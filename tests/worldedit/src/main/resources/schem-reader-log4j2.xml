<?xml version="1.0" encoding="UTF-8"?>
<!-- All logging goes to stderr; stdout is reserved for the single JSON result object. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="StdErr" target="SYSTEM_ERR">
            <PatternLayout pattern="[schem-reader %d{HH:mm:ss}] [%level] %c{1}: %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="StdErr"/>
        </Root>
    </Loggers>
</Configuration>
