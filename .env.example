# Minecraft Christmas Builder – Umgebungsvariablen
# Kopiere diese Datei nach ".env.local" und passe sie an. Ohne .env.local läuft die App
# vollständig regelbasiert (keine KI, keine Netzwerkzugriffe nach außen).

# Optionale lokale KI-Planung über Ollama (läuft auf deinem PC, keine Kosten, kein API-Key).
# Anleitung: docs/LOCAL_AI.md
# MCB_AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:14b
# Zeitlimit pro Planung in Millisekunden (5000–600000, Standard 120000)
# MCB_AI_TIMEOUT_MS=120000
# "think" für Reasoning-Modelle: false (Standard, schneller), true oder unset (Feld nicht senden)
# OLLAMA_THINK=false
