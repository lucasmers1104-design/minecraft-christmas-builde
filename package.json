{
  "name": "minecraft-christmas-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Generate Minecraft Java Christmas buildings as real block data with 3D preview and Sponge Schematic v3 export.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worldedit:build": "bash tests/worldedit/build.sh",
    "test:worldedit": "node scripts/test-worldedit.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "dexie": "4.4.6",
    "next": "16.4.2",
    "prismarine-nbt": "2.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.6",
    "minecraft-data": "3.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vitest": "5.0.5"
  }
}
